# HeartbeatScan access gate
# NEVER commit real credentials or personal email addresses.
HEARTBEATSCAN_TOKEN=replace-with-high-entropy-secret
HEARTBEATSCAN_PLUS_CODE=replace-with-controller-plus-code
HEARTBEATSCAN_ALLOWED_CIDRS=replace-with-controller-network-cidr
HEARTBEATSCAN_ALLOWED_EMAILS=authorized@example.com

# Optional trusted peer fan-out
GAIA_PEERS=
